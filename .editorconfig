root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,gradle,sh}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.xml]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
