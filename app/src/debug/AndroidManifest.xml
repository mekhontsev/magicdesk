<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service android:name=".HostedFixtureIme" android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD" android:label="MagicDesk IME verification">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/hosted_fixture_ime" />
        </service>
        <activity
            android:name=".DebugDependentWindowActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:taskAffinity="io.github.mekhontsev.magicdesk.debug.dependent" />
        <activity
            android:name=".DebugContentExchangeActivity"
            android:theme="@style/TransparentActivityTheme"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:taskAffinity="io.github.mekhontsev.magicdesk.debug.content" />
        <activity
            android:name=".DebugUiAutomationActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:taskAffinity="io.github.mekhontsev.magicdesk.debug.automation" />
        <activity
            android:name=".DebugSelfTestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:taskAffinity="io.github.mekhontsev.magicdesk.debug.selftest"
            android:theme="@style/TransparentActivityTheme" />
    </application>

    <instrumentation
        android:name=".ShellPanelInstrumentation"
        android:functionalTest="true"
        android:targetPackage="io.github.mekhontsev.magicdesk" />
    <instrumentation
        android:name=".ShellProbeInstrumentation"
        android:functionalTest="true"
        android:targetPackage="io.github.mekhontsev.magicdesk" />
    <instrumentation
        android:name=".WaylandRuntimeInstrumentation"
        android:functionalTest="true"
        android:targetPackage="io.github.mekhontsev.magicdesk" />
    <instrumentation
        android:name=".HostedInputInstrumentation"
        android:functionalTest="true"
        android:targetPackage="io.github.mekhontsev.magicdesk" />
    <instrumentation
        android:name=".HostedGuestEditorInstrumentation"
        android:functionalTest="true"
        android:targetPackage="io.github.mekhontsev.magicdesk" />
    <instrumentation
        android:name="com.termux.terminal.TerminalRenderingInstrumentation"
        android:functionalTest="true"
        android:targetPackage="io.github.mekhontsev.magicdesk" />
    <instrumentation
        android:name=".platform.nubia.NubiaVendorProbeInstrumentation"
        android:functionalTest="true"
        android:targetPackage="io.github.mekhontsev.magicdesk" />
</manifest>
