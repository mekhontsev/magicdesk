<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/notification_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingEnd="8dp"
        android:background="@android:drawable/list_selector_background"
        android:screenReaderFocusable="true"
        android:tooltipText="@string/notification_open_control_panel"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

        <TextView
            android:id="@+id/notification_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/notification_console"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:background="@android:drawable/list_selector_background"
        android:src="@drawable/ic_file_console"
        android:tint="@color/notification_control"
        android:contentDescription="@string/console_title"
        android:tooltipText="@string/console_title" />

    <ImageButton
        android:id="@+id/notification_black_screen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:background="@android:drawable/list_selector_background"
        android:src="@drawable/ic_phone_screen_off"
        android:tint="@color/notification_control"
        android:contentDescription="@string/notification_black_screen"
        android:tooltipText="@string/notification_black_screen" />

    <ImageButton
        android:id="@+id/notification_touchpad"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:visibility="gone"
        android:background="@android:drawable/list_selector_background"
        android:src="@drawable/ic_touchpad"
        android:tint="@color/notification_control"
        android:contentDescription="@string/action_open_touchpad"
        android:tooltipText="@string/action_open_touchpad" />
</LinearLayout>
