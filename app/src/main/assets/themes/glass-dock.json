{
  "version": 6,
  "preset": "dark",
  "palette": {
    "light": {
      "background": "#F5F1F4", "panel": "#FFFAFD", "surface": "#EDE3E9",
      "text": "#30262D", "muted": "#665A64", "accent": "#93445F",
      "danger": "#B32643", "attention": "#805C19", "hover": "#E1CFDB",
      "surface_low": "#FFFAFD", "surface_high": "#E1CFDB", "outline": "#766A73",
      "on_accent": "#FFFFFF", "accent_container": "#F8D9E5", "on_accent_container": "#432030",
      "desktop_text": "#F6F4F7"
    },
    "dark": {
      "background": "#19191D", "panel": "#25252B", "surface": "#37373F",
      "text": "#F6F4F7", "muted": "#C0BBC7", "accent": "#F2A8C0",
      "danger": "#FF8495", "attention": "#F3CD81", "hover": "#4B4652",
      "surface_low": "#25252B", "surface_high": "#4B4652", "outline": "#C0BBC7",
      "on_accent": "#432030", "accent_container": "#593347", "on_accent_container": "#F8D9E5",
      "desktop_text": "#F6F4F7"
    }
  },
  "typography": { "font": "sans", "scale": 1 },
  "shape": { "radiusScale": 1, "borderDp": 1 },
  "backdrop": { "opacity": 0.92, "blurRadiusDp": 24 },
  "composition": {
    "panels": [{
      "id": "dock", "edge": "bottom",
      "style": { "length": "content", "alignment": "center", "maxLengthDp": 1000, "sideGapDp": 12, "edgeGapDp": 12, "thicknessDp": 64, "paddingDp": 8, "radiusDp": 8, "reserveSpace": true, "hover": { "scale": 1.5, "liftDp": 8, "radius": 1.5 } },
      "components": [
        { "type": "start", "widthDp": 64 }, { "type": "tasks" },
        { "type": "open_tasks" }, { "type": "notifications", "minViewportDp": 640 },
        { "type": "quick_controls" }, { "type": "clock", "minViewportDp": 480 }
      ]
    }],
    "start": { "sections": ["apps", "recent", "running", "tools"], "presentation": "grid", "tileWidthDp": 104, "iconSizeDp": 44 }
  },
  "feedback": { "normal": "transparent", "hover": "surface", "pressed": "hover", "selected": "surface", "focused": "hover", "disabled": "transparent", "outline": "accent" },
  "motion": { "panels": "slide_scale", "taskbar": "slide", "durationMs": 160, "feedbackMs": 60, "curve": "ease_out", "distanceDp": 8, "scaleFrom": 0.98, "wallpaper": true }
}
