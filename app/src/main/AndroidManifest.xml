<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.termux" />
        <package android:name="com.termux.x11" />
        <package android:name="cn.nubia.redmagickyi" />
        <package android:name="cn.zte.chargeseparation" />
        <package android:name="cn.nubia.touping" />
        <provider android:authorities="cn.nubia.touping.TouPingProvider" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".MagicDeskApplication"
        android:allowBackup="false"
        android:banner="@mipmap/ic_launcher"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:logo="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme">
        <service
            android:name=".MagicDeskAppFunctionService"
            android:enabled="@bool/app_functions_available"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions"
                android:value="magicdesk_app_functions_v1.xml" />
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="magicdesk_app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_function_app_metadata" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name=".DesktopFileProvider"
            android:authorities="${applicationId}.desktop-files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <provider
            android:name=".ShellFileProvider"
            android:authorities="${applicationId}.shell-files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".FileManagerActivity"
            android:exported="true"
            android:icon="@drawable/ic_desktop_folder"
            android:label="@string/file_manager_title"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.files" />

        <activity
            android:name=".AddWebShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/ic_desktop_web_link"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/TransparentActivityTheme">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DesktopContentReceiverActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/ic_desktop_folder"
            android:label="@string/desktop_share_target"
            android:taskAffinity=""
            android:theme="@style/TransparentActivityTheme">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AndroidActivityRelayActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.intent_result"
            android:theme="@style/TransparentActivityTheme" />

        <activity
            android:name=".DeviceSetupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:banner="@mipmap/ic_launcher"
            android:icon="@mipmap/ic_launcher"
            android:logo="@mipmap/ic_launcher"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/ic_launcher"
            android:resizeableActivity="true"
            android:theme="@style/TransparentActivityTheme" />

        <activity
            android:name=".ControlActivity"
            android:exported="true"
            android:banner="@mipmap/ic_launcher"
            android:icon="@mipmap/ic_launcher"
            android:logo="@mipmap/ic_launcher"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/ic_launcher"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.control">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PhoneHomeActivity"
            android:banner="@mipmap/ic_launcher"
            android:clearTaskOnLaunch="true"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTask"
            android:logo="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:stateNotNeeded="true"
            android:taskAffinity="${applicationId}.phone_home"
            android:theme="@style/PhoneHomeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.HOME" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PhoneDesktopHomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:enabled="false"
            android:exported="true"
            android:banner="@mipmap/ic_launcher"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTask"
            android:logo="@mipmap/ic_launcher"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:roundIcon="@mipmap/ic_launcher"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.phone_desktop_home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.HOME" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DesktopActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:banner="@mipmap/ic_launcher"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTask"
            android:logo="@mipmap/ic_launcher"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:roundIcon="@mipmap/ic_launcher"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.desktop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DesktopTaskbarActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:taskAffinity="${applicationId}.desktop_taskbar"
            android:theme="@style/DesktopTaskbarTheme" />

        <!-- Keeps organizer-owned fullscreen slots structurally non-empty.
             The standard task is retained while its slot is reused. -->
        <activity
            android:name=".TaskAreaBackstopActivity"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:process=":task_area_backstop"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.task_area_backstop"
            android:theme="@style/TaskAreaBackstopTheme" />

        <!-- Keep a running self-test alive while external-display setup changes
             the phone's orientation and display metrics. -->
        <activity
            android:name=".DiagnosticsActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize"
            android:exported="true"
            android:label="@string/diagnostics_title"
            android:launchMode="singleTop"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.diagnostics" />

        <activity
            android:name=".CompatibilityOnboardingActivity"
            android:exported="false"
            android:label="@string/onboarding_title"
            android:resizeableActivity="true" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:launchMode="singleTop"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.settings" />

        <activity
            android:name=".DesktopSelfTestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/self_test_window_target"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:process=":selftest"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.selftest" />

        <activity
            android:name=".DesktopSelfTestBrowserActivity"
            android:configChanges="keyboard|keyboardHidden|layoutDirection|mcc|mnc|orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/self_test_window_target"
            android:launchMode="singleTask"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:process=":selftest"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:taskAffinity="${applicationId}.selftest.browser"
            android:theme="@style/SelfTestBrowserTheme"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CommandConsoleActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:icon="@drawable/ic_file_console"
            android:label="@string/console_title"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.console" />

        <activity
            android:name=".TaskManagerActivity"
            android:exported="true"
            android:icon="@drawable/ic_magicdesk"
            android:label="@string/task_manager_title"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.tasks" />

        <activity
            android:name=".AppLogViewerActivity"
            android:exported="true"
            android:icon="@drawable/ic_magicdesk"
            android:label="@string/app_logs_fallback_title"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.logs" />

        <activity
            android:name=".MagicDeskTouchpadActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="false"
            android:taskAffinity="${applicationId}.touchpad" />

        <service
            android:name=".MagicDeskRuntimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors external input and display state for desktop controls" />
        </service>

        <service
            android:name=".DesktopNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".TermuxCommandResultReceiver"
            android:exported="false" />

    </application>
</manifest>
