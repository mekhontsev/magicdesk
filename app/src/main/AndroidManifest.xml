<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="cn.nubia.keymapcenter" />
        <package android:name="cn.nubia.redmagickyi" />
        <package android:name="cn.zte.chargeseparation" />
        <package android:name="com.zte.mifavor.launcher" />
        <provider android:authorities="cn.nubia.touping.TouPingProvider" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
    </queries>

    <application
        android:name=".MagicDeskApplication"
        android:allowBackup="false"
        android:banner="@mipmap/ic_launcher"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:logo="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme">
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name=".DesktopFileProvider"
            android:authorities="${applicationId}.desktop-files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".DeviceSetupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:banner="@mipmap/ic_launcher"
            android:icon="@mipmap/ic_launcher"
            android:logo="@mipmap/ic_launcher"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/ic_launcher"
            android:resizeableActivity="true"
            android:theme="@style/TransparentActivityTheme" />

        <activity
            android:name=".ControlActivity"
            android:exported="true"
            android:banner="@mipmap/ic_launcher"
            android:icon="@mipmap/ic_launcher"
            android:logo="@mipmap/ic_launcher"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/ic_launcher"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.control">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- This transient seed requests the landscape external-display configuration. -->
        <activity
            android:name=".ConsoleSeedActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:resizeableActivity="true"
            android:screenOrientation="landscape"
            android:taskAffinity="${applicationId}.consoleseed"
            android:theme="@style/ConsoleSeedTheme"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".DesktopActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:banner="@mipmap/ic_launcher"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTop"
            android:logo="@mipmap/ic_launcher"
            android:permission="android.permission.MANAGE_ACTIVITY_TASKS"
            android:roundIcon="@mipmap/ic_launcher"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.desktop" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_title"
            android:launchMode="singleTop"
            android:resizeableActivity="true" />

        <activity
            android:name=".CommandConsoleActivity"
            android:exported="false"
            android:label="@string/console_title"
            android:launchMode="singleTop"
            android:resizeableActivity="true" />

        <activity
            android:name=".FreeformLaunchAnchorActivity"
            android:configChanges="density|orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.desktoplaunch"
            android:theme="@style/TransparentActivityTheme" />

        <service
            android:name=".MagicDeskRuntimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors external input and display state for desktop controls" />
        </service>

        <service
            android:name=".DesktopNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
